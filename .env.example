# Copy to .env (git-ignored) and fill in. Never commit real values.
# Modules add their own variables below when enabled.

# databricks
# DATABRICKS_HOST: https://<workspace>.cloud.databricks.com
DATABRICKS_HOST=
# DATABRICKS_TOKEN: set via `databricks auth login`; prefer OAuth over tokens
DATABRICKS_TOKEN=

# kafka
# KAFKA_BOOTSTRAP: host:port
KAFKA_BOOTSTRAP=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# KAFKA_SASL_MECHANISM: SCRAM-SHA-256
KAFKA_SASL_MECHANISM=
# KAFKA_CA_PATH: /absolute/path/outside/repo/ca.pem
KAFKA_CA_PATH=
# KAFKA_TOPIC: meter-readings
KAFKA_TOPIC=
# REPLAY_SPEED: event seconds per wall-clock second; 0 = no pacing
REPLAY_SPEED=
# SAMPLE_STREAM_FILE: path to data/sample/seed42/stream/readings_stream.csv (inside the container: /data/readings_stream.csv)
SAMPLE_STREAM_FILE=

# integration tests (optional)
# DATABRICKS_WAREHOUSE_ID: id of the Free Edition SQL warehouse
DATABRICKS_WAREHOUSE_ID=
